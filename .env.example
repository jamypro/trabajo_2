# ============================================================
# PayFlow - Variables de entorno (plantilla)
# Copia este archivo a .env y configura tus valores.
# ============================================================

# Puerto de la aplicación
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=newpassword
DB_DATABASE=payflow
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1h

# Seed (credenciales del ADMIN inicial)
SEED_ADMIN_EMAIL=admin@payflow.com
SEED_ADMIN_PASSWORD=Admin123!
